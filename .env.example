# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Server-side secret password for accessing the Admin Dashboard.
# Never exposed in frontend code. Configure via AI Studio Secrets panel.
ADMIN_PASSWORD=""

# CLIENT_UPLOAD_PASSWORD: Server-side secret password required for clients to access Client Video Upload.
# Never exposed in frontend code. Configure via AI Studio Secrets panel.
CLIENT_UPLOAD_PASSWORD=""

# OWNER_EMAIL: Authorized Google account email for portfolio ownership and notifications.
OWNER_EMAIL="rafiulislamrupom11@gmail.com"

# GOOGLE_SHEET_ID: Central Google Spreadsheet ID containing Website Visitors, Contact Messages, Video Uploads, Portfolio Projects, and Client Uploads tabs.
GOOGLE_SHEET_ID=""

# GOOGLE_DRIVE_FOLDER_ID: Google Drive Folder ID for 'Rupam Portfolio Uploads'.
GOOGLE_DRIVE_FOLDER_ID=""

# CLIENT_UPLOADS_FOLDER_ID: Google Drive Folder ID for 'Client Uploads' parent directory.
CLIENT_UPLOADS_FOLDER_ID=""

# APPS_SCRIPT_WEB_APP_URL: Optional Google Apps Script Web App deployment URL for server-to-Workspace execution.
APPS_SCRIPT_WEB_APP_URL=""

